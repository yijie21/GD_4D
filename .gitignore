# --- weights & external code: never commit contents (keep README + .gitkeep) ---
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/README.md
third_party/*
!third_party/.gitkeep
!third_party/README.md

# --- datasets: live outside the repo, referenced via the data/ symlink ---
/data

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- model / data artifacts ---
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz

# --- logging / experiment output ---
wandb/
outputs/
runs/
logs/
*.log

# --- env / editor ---
.venv/
.env
.vscode/
.idea/
.DS_Store
